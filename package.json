{
  "name": "souhait-me",
  "type": "module",
  "scripts": {
    "postinstall": "tsx scripts/download_assets.ts",
    "dev": "vite",
    "build": "vite build --mode client && vite build",
    "preview": "wrangler dev",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "concurrently --pad-prefix node:lint:*",
    "lint:typescript": "tsc --noEmit",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint .",
    "format": "eslint --fix . && stylelint --fix ."
  },
  "private": true,
  "dependencies": {
    "hono": "4.13.19",
    "honox": "0.1.63",
    "tailwind-merge": "3.7.1",
    "tailwind-variants": "4.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261121.1",
    "@hono/vite-build": "1.11.1",
    "@hono/vite-dev-server": "0.26.1",
    "@stylistic/stylelint-config": "6.1.0",
    "@tailwindcss/vite": "4.3.5",
    "@taiyme/eslint-config": "1.0.1",
    "@taiyme/vite-plugin-jsx-prune-classname": "0.0.3",
    "@types/node": "26.6.6",
    "@typescript-eslint/parser": "8.73.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "kiso.css": "1.2.4",
    "sharp": "0.35.5",
    "stylelint": "18.1.0",
    "stylelint-config-recess-order": "7.10.1",
    "stylelint-config-recommended": "19.1.0",
    "stylelint-config-tailwindcss": "1.0.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "wrangler": "4.166.0"
  },
  "packageManager": "pnpm@12.21.0"
}
